# Skopiuj do pliku .env i dostosuj.

# ── Baza ─────────────────────────────────────────────────
# Lokalny MySQL (host):
# DATABASE_URL=mysql+mysqldb://root@127.0.0.1:3306/wms_db
# Docker Compose (serwis `db` w docker-compose.yml):
# DATABASE_URL=mysql+mysqldb://root:password@db:3306/wms_db

DATABASE_URL=mysql+mysqldb://root:password@db:3306/wms_db

# ── JWT (min. 32 znaki) ──────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

APP_NAME=WMS System
APP_VERSION=1.0.0
DEBUG=false

# ── CORS ─────────────────────────────────────────────────
# Frontend Vite; dodaj konkretny origin LAN jeśli potrzeba:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# localhost z dowolnym portem:
CORS_ALLOW_LOCALHOST_REGEX=true
# Frontend pod http://192.168.x.x:5173 lub 10.x.x.x — demo w LAN:
CORS_ALLOW_LAN=true

SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=5

# ── Pierwszy administrator (seed przy starcie) ───────────
ADMIN_EMAIL=admin@wms.pl
# Min. 8 znaków, litery i cyfry — nie używaj słabych haseł domyślnych z walidatora
ADMIN_PASSWORD=

# ── Demo: magazynier + zadania (pusta tabela tasks) ──────
SEED_DEMO_TASKS=true
DEMO_WORKER_EMAIL=magazynier@demo.wms
DEMO_WORKER_PASSWORD=Demo1234
