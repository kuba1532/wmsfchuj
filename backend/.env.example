# Skopiuj do .env (nie commituj .env):
#   cp .env.example .env
# PowerShell:  Copy-Item .env.example .env
#
# JWT: openssl rand -hex 32   (min. 32 znaki)
# ADMIN_PASSWORD: nie używaj dosłownie Admin123! (walidator to odrzuci).

# --- Baza ---
# Docker Compose (backend + db w jednej sieci):
DATABASE_URL=mysql+mysqldb://root:password@db:3306/wms_db
# Tylko baza w Dockerze, uvicorn na hoście (port hosta z docker-compose, u nas 3307):
# DATABASE_URL=mysql+mysqldb://root:password@127.0.0.1:3307/wms_db
# Lokalny MySQL na Windows/macOS:
# DATABASE_URL=mysql+mysqldb://root@127.0.0.1:3306/wms_db

DB_POOL_SIZE=30
DB_MAX_OVERFLOW=60
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

APP_NAME=WMS System
APP_VERSION=1.0.0
DEBUG=false

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ALLOW_LOCALHOST_REGEX=true
CORS_ALLOW_LAN=true

SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=5
# Polityka haseł (N-04): wymuszenie zmiany hasła co N dni (0 = wyłączone).
PASSWORD_MAX_AGE_DAYS=180

# --- Bezpieczeństwo (nagłówki / hardening) ---
SECURITY_HEADERS_ENABLED=true
# HSTS włącz dopiero za HTTPS (produkcja). Lokalnie zostaw false.
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000
# Produkcja: ogranicz hosty, np. TRUSTED_HOSTS=wms.example.com,api.wms.example.com
TRUSTED_HOSTS=*
# Limit zapytań/min z jednego IP (0 = wyłączone). Produkcja np. 120.
RATE_LIMIT_PER_MINUTE=0

ADMIN_EMAIL=admin@wms.pl
ADMIN_PASSWORD=

SEED_DEMO_TASKS=true
DEMO_WORKER_EMAIL=operator@wms.pl
DEMO_WORKER_PASSWORD=Demo1234

FRONTEND_BASE_URL=http://localhost:5173

SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@wms.pl
