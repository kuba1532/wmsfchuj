# WMS backend — zestaw developerski (Docker Compose).
# Tylko MySQL w Dockerze, uvicorn na hoście — podmień DATABASE_URL na:
# DATABASE_URL=mysql+mysqldb://root:password@127.0.0.1:3307/wms_db
# Lokalny MySQL bez Dockera:
# DATABASE_URL=mysql+mysqldb://root@127.0.0.1:3306/wms_db

DATABASE_URL=mysql+mysqldb://root:password@db:3306/wms_db
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=60
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

JWT_SECRET_KEY=wms-dev-secret-key-2026-super-long-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

APP_NAME=WMS System
APP_VERSION=1.0.0
DEBUG=false

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ALLOW_LOCALHOST_REGEX=true
CORS_ALLOW_LAN=true

SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=5

ADMIN_EMAIL=admin@wms.pl
ADMIN_PASSWORD=MojeHasloAdmina2026!WMS

SEED_DEMO_TASKS=true
DEMO_WORKER_EMAIL=operator@wms.pl
DEMO_WORKER_PASSWORD=Demo1234

FRONTEND_BASE_URL=http://localhost:5173

SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@wms.pl
