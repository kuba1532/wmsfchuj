# WMS backend — zestaw developerski (Docker Compose).
# Produkcja: wygeneruj własne sekrety i zmień hasła.
#
# Lokalny MySQL bez Dockera — podmień na:
# DATABASE_URL=mysql+mysqldb://root@127.0.0.1:3306/wms_db

DATABASE_URL=mysql+mysqldb://root:password@db:3306/wms_db
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=60
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

