# Skopiuj do .env.prod i uzupełnij. NIE commituj .env.prod (są w nim sekrety).
#   cp .env.prod.example .env.prod

# Domena publiczna (musi wskazywać na IP serwera w DNS) — używana przez Caddy (HTTPS),
# TRUSTED_HOSTS i CORS backendu.
PUBLIC_DOMAIN=wms.twojadomena.pl

# Baza danych (silne hasło!)
DB_ROOT_PASSWORD=ZMIEN_NA_DLUGIE_LOSOWE_HASLO
DB_NAME=wms_db

# Klucz JWT — wygeneruj: openssl rand -hex 32
JWT_SECRET_KEY=ZMIEN_NA_WYNIK_openssl_rand_hex_32

# Konto administratora (pierwsze logowanie)
ADMIN_EMAIL=admin@twojadomena.pl
ADMIN_PASSWORD=ZMIEN_NA_SILNE_HASLO_ADMINA
